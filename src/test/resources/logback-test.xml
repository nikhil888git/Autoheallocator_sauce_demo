<configuration>

    <!-- Console Appender -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [Thread:%thread] [Trace:%X{traceId}] [Test:%X{scenario}] [Env:%X{env}] [Browser:%X{browser}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Automation Log (Framework Execution) -->
    <appender name="AUTOMATION_LOG" class="ch.qos.logback.core.FileAppender">
        <file>target/logs/automation.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [Thread:%thread] [Trace:%X{traceId}] [Test:%X{scenario}] [Env:%X{env}] [Browser:%X{browser}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Failures Log (Errors only) -->
    <appender name="FAILURES_LOG" class="ch.qos.logback.core.FileAppender">
        <file>target/logs/failures.log</file>
        <append>false</append>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [Thread:%thread] [Trace:%X{traceId}] [Test:%X{scenario}] [Env:%X{env}] [Browser:%X{browser}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Telemetry Log (AI / Auto-Heal) -->
    <appender name="TELEMETRY_LOG" class="ch.qos.logback.core.FileAppender">
        <file>target/logs/telemetry.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [Thread:%thread] [Trace:%X{traceId}] [Test:%X{scenario}] [Env:%X{env}] [Browser:%X{browser}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- API Log -->
    <appender name="API_LOG" class="ch.qos.logback.core.FileAppender">
        <file>target/logs/api.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [Thread:%thread] [Trace:%X{traceId}] [Test:%X{scenario}] [Env:%X{env}] [Browser:%X{browser}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Loggers -->
    
    <!-- API specific logs -->
    <logger name="io.restassured" level="INFO" additivity="false">
        <appender-ref ref="API_LOG" />
        <appender-ref ref="STDOUT" />
    </logger>
    <logger name="com.demo.stepdefs.api" level="DEBUG" additivity="false">
        <appender-ref ref="API_LOG" />
        <appender-ref ref="AUTOMATION_LOG" />
        <appender-ref ref="STDOUT" />
    </logger>

    <!-- Telemetry specific logs -->
    <logger name="com.demo.utils.autoheal" level="DEBUG" additivity="false">
        <appender-ref ref="TELEMETRY_LOG" />
        <appender-ref ref="AUTOMATION_LOG" />
        <appender-ref ref="STDOUT" />
    </logger>

    <!-- Set root level for general automation flow -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="AUTOMATION_LOG" />
        <appender-ref ref="FAILURES_LOG" />
    </root>

</configuration>
